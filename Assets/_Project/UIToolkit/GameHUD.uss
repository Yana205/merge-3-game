/* GameHUD.uss — the Crystal Cavern HUD window.

   Metrics are the kit README section 5 numbers scaled up ~1.2-1.3x for
   legibility: the panel renders through PanelSettings' ScaleWithScreenSize, so
   every px here is multiplied by the screen/reference ratio before it reaches a
   pixel. The kit's original 11px field labels landed at roughly 8px on a 960px
   canvas, which is why the HUD read as unlabelled numbers.

   The recessive label colour was lifted a step too (#8F6FC9 -> #A78BDA); at
   this size the original sat too close to the panel fill to read.

   Still demonstrates the three selector kinds:
     - type selector   -> Button
     - ID selector     -> #score-label
     - class selector  -> .panel-header
*/

/* Root fills the screen but ignores picking so gameplay clicks pass through. */
.hud-root {
    flex-grow: 1;
    align-items: flex-start;
    justify-content: flex-start;
}

/* 9-slice frame. -unity-slice-* must match the sprite border set on import,
   and -unity-slice-scale keeps the 8px corners from being stretched. */
.panel {
    margin: 16px;
    padding: 18px 20px;
    width: 260px;
    background-image: url("project:///Assets/_Project/Art/ui-kit/sprites/panel_window.png");
    -unity-slice-left: 8;
    -unity-slice-top: 8;
    -unity-slice-right: 8;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 1px;
}

.heading-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.heading-icon {
    width: 24px;
    height: 24px;
    margin-right: 8px;
    background-image: url("project:///Assets/_Project/Art/ui-kit/sprites/icon_gem.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* CLASS SELECTOR — the panel heading. Silkscreen 13 / 0.14em / #6EE6E0. */
.panel-header {
    -unity-font-definition: url("project:///Assets/_Project/Art/ui-kit/fonts/Silkscreen-Regular.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    color: rgb(110, 230, 224);
    -unity-text-align: middle-left;
}

/* Label hard left, numeral hard right. */
.stat-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

/* Silkscreen 11 / 0.10em / #8F6FC9 — recessive by design. */
.field-label {
    -unity-font-definition: url("project:///Assets/_Project/Art/ui-kit/fonts/Silkscreen-Regular.ttf");
    font-size: 15px;
    letter-spacing: 1px;
    color: rgb(167, 139, 218);
}

/* Numerals are Jersey 25, neutral #CFF8F2 by default. */
.numeral {
    -unity-font-definition: url("project:///Assets/_Project/Art/ui-kit/fonts/Jersey25-Regular.ttf");
    font-size: 34px;
    color: rgb(207, 248, 242);
    -unity-text-align: middle-right;
}

/* ID SELECTOR — the live score is the one gold numeral (#F5C542). */
#score-label {
    color: rgb(245, 197, 66);
}

.numeral--gold {
    color: rgb(245, 197, 66);
}

/* TYPE SELECTOR — every Button in this HUD uses the kit's 9-slice frame. */
Button {
    margin-top: 4px;
    padding: 10px 12px;
    -unity-font-definition: url("project:///Assets/_Project/Art/ui-kit/fonts/Silkscreen-Bold.ttf");
    font-size: 15px;
    letter-spacing: 1px;
    color: rgb(165, 242, 236);
    background-image: url("project:///Assets/_Project/Art/ui-kit/sprites/button_normal.png");
    background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 6;
    -unity-slice-top: 6;
    -unity-slice-right: 6;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 1px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

Button:hover {
    background-image: url("project:///Assets/_Project/Art/ui-kit/sprites/button_selected.png");
    color: rgb(239, 255, 252);
}

Button:active {
    background-image: url("project:///Assets/_Project/Art/ui-kit/sprites/button_pressed.png");
}

/* --- Corruption meter ---------------------------------------------------
   The run's clock. The track is a sunken slot; the fill's width and colour are
   both driven from UIController, because the colour ramps continuously
   (cyan -> amber -> red) and USS has no way to express a gradient over a
   bound value. */

.meter-track {
    height: 10px;
    margin-top: 2px;
    margin-bottom: 6px;
    background-color: rgba(0, 0, 0, 0.45);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(0, 0, 0, 0.6);
    border-right-color: rgba(0, 0, 0, 0.6);
    border-top-color: rgba(0, 0, 0, 0.6);
    border-bottom-color: rgba(0, 0, 0, 0.6);
    overflow: hidden;
}

.meter-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(90, 214, 208);
    /* Eased so a merge's drain reads as the bar RECEDING — an instant jump
       would not register as the player having pushed the threat back. */
    transition-property: width, background-color;
    transition-duration: 0.25s, 0.25s;
    transition-timing-function: ease-out;
}

.numeral--warn {
    color: rgb(232, 122, 106);
}

/* --- Pickaxe -----------------------------------------------------------
   Three states the player must be able to tell apart at a glance: empty
   (nothing to spend), ready (a charge banked), armed (the next tap shatters).

   Empty is genuinely DISABLED, not merely dimmed. It used to be dim but still
   clickable, so a click on it ran TryArm(), got false back, and did nothing
   visible — a control that accepts input and silently ignores it teaches the
   player that it is broken.

   Ready pulses. UI Toolkit has no keyframe animation, so UIController toggles
   --pulse on a scheduler and the transition below does the easing. */

.pickaxe-button {
    transition-property: color, opacity, scale;
    transition-duration: 0.35s, 0.35s, 0.35s;
    transition-timing-function: ease-in-out;
}

.pickaxe-button--empty {
    opacity: 0.3;
}

/* SetEnabled(false) also suppresses :hover and :active, so a disabled button
   cannot light up under the cursor and promise something it will not do. */
.pickaxe-button:disabled {
    opacity: 0.3;
    color: rgb(120, 150, 148);
}

.pickaxe-button--ready {
    color: rgb(245, 197, 66);
}

/* Toggled on and off by UIController's scheduler. Only ever applied in the
   ready state — a control that pulses in every state attracts nothing. */
.pickaxe-button--pulse {
    color: rgb(255, 246, 219);
    scale: 1.05 1.05;
}

/* Last, so it wins over --ready and --pulse at equal specificity. Armed borrows
   the pressed frame so the button visibly stays down — the board is in a mode,
   and a flat button would not say so. */
.pickaxe-button--armed {
    background-image: url("project:///Assets/_Project/Art/ui-kit/sprites/button_pressed.png");
    color: rgb(245, 197, 66);
    scale: 1 1;
}

/* The jam prompt. Gold on the panel, hidden until the board actually jams with
   a charge in hand — display:none rather than opacity so it takes no layout
   space in the normal case and the panel does not reserve a gap for it. */
.rescue-hint {
    -unity-font-definition: url("project:///Assets/_Project/Art/ui-kit/fonts/Silkscreen-Bold.ttf");
    font-size: 12px;
    letter-spacing: 1px;
    color: rgb(245, 197, 66);
    white-space: normal;
    margin-top: 8px;
    display: none;
}

.rescue-hint--visible {
    display: flex;
}
