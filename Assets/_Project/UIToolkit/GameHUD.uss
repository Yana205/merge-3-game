/* GameHUD.uss — the Crystal Cavern HUD window.

   Metrics are the kit README section 5 numbers scaled up ~1.2-1.3x for
   legibility: the panel renders through PanelSettings' ScaleWithScreenSize, so
   every px here is multiplied by the screen/reference ratio before it reaches a
   pixel. The kit's original 11px field labels landed at roughly 8px on a 960px
   canvas, which is why the HUD read as unlabelled numbers.

   The recessive label colour was lifted a step too (#8F6FC9 -> #A78BDA); at
   this size the original sat too close to the panel fill to read.

   Still demonstrates the three selector kinds:
     - type selector   -> Button
     - ID selector     -> #score-label
     - class selector  -> .panel-header
*/

/* Root fills the screen but ignores picking so gameplay clicks pass through. */
.hud-root {
    flex-grow: 1;
    align-items: flex-start;
    justify-content: flex-start;
}

/* 9-slice frame. -unity-slice-* must match the sprite border set on import,
   and -unity-slice-scale keeps the 8px corners from being stretched. */
.panel {
    margin: 16px;
    padding: 18px 20px;
    width: 260px;
    background-image: url("project:///Assets/_Project/Art/ui-kit/sprites/panel_window.png");
    -unity-slice-left: 8;
    -unity-slice-top: 8;
    -unity-slice-right: 8;
    -unity-slice-bottom: 8;
    -unity-slice-scale: 1px;
}

.heading-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.heading-icon {
    width: 24px;
    height: 24px;
    margin-right: 8px;
    background-image: url("project:///Assets/_Project/Art/ui-kit/sprites/icon_gem.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* CLASS SELECTOR — the panel heading. Silkscreen 13 / 0.14em / #6EE6E0. */
.panel-header {
    -unity-font-definition: url("project:///Assets/_Project/Art/ui-kit/fonts/Silkscreen-Regular.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    color: rgb(110, 230, 224);
    -unity-text-align: middle-left;
}

/* Label hard left, numeral hard right. */
.stat-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

/* Silkscreen 11 / 0.10em / #8F6FC9 — recessive by design. */
.field-label {
    -unity-font-definition: url("project:///Assets/_Project/Art/ui-kit/fonts/Silkscreen-Regular.ttf");
    font-size: 15px;
    letter-spacing: 1px;
    color: rgb(167, 139, 218);
}

/* Numerals are Jersey 25, neutral #CFF8F2 by default. */
.numeral {
    -unity-font-definition: url("project:///Assets/_Project/Art/ui-kit/fonts/Jersey25-Regular.ttf");
    font-size: 34px;
    color: rgb(207, 248, 242);
    -unity-text-align: middle-right;
}

/* ID SELECTOR — the live score is the one gold numeral (#F5C542). */
#score-label {
    color: rgb(245, 197, 66);
}

.numeral--gold {
    color: rgb(245, 197, 66);
}

/* TYPE SELECTOR — every Button in this HUD uses the kit's 9-slice frame. */
Button {
    margin-top: 4px;
    padding: 10px 12px;
    -unity-font-definition: url("project:///Assets/_Project/Art/ui-kit/fonts/Silkscreen-Bold.ttf");
    font-size: 15px;
    letter-spacing: 1px;
    color: rgb(165, 242, 236);
    background-image: url("project:///Assets/_Project/Art/ui-kit/sprites/button_normal.png");
    background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 6;
    -unity-slice-top: 6;
    -unity-slice-right: 6;
    -unity-slice-bottom: 6;
    -unity-slice-scale: 1px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

Button:hover {
    background-image: url("project:///Assets/_Project/Art/ui-kit/sprites/button_selected.png");
    color: rgb(239, 255, 252);
}

Button:active {
    background-image: url("project:///Assets/_Project/Art/ui-kit/sprites/button_pressed.png");
}

/* --- Score punch --------------------------------------------------------
   UI Toolkit has no keyframe animation, so the punch is a class UIController
   toggles on for one beat: scale snaps up with the class, and this transition
   eases it back down when the class is removed. */

.score-numeral {
    transition-property: scale, color;
    transition-duration: 0.18s;
    transition-timing-function: ease-out-cubic;
}

.score-numeral--punch {
    scale: 1.25 1.25;
    color: rgb(255, 246, 219);
}

/* Absolutely positioned so it does not take part in .hud-root's top-left flow —
   the score panel must not move because a hint appeared.

   ABOVE the board, not below it. Below is where the queue previews live, and a
   caption there lands directly on top of the three crystals it is describing. */
.place-hint-row {
    position: absolute;
    left: 0;
    right: 0;
    top: 14px;
    align-items: center;
}

.place-hint {
    -unity-font-definition: url("project:///Assets/_Project/Art/ui-kit/fonts/Silkscreen-Bold.ttf");
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(245, 197, 66);
    padding: 6px 14px;
    background-color: rgba(12, 8, 32, 0.72);
    border-radius: 4px;
    transition-property: opacity;
    transition-duration: 0.45s;
    opacity: 1;
}

/* Faded rather than display:none — the row keeps its size, so nothing under the
   board shifts at the moment the player makes their first move. */
.place-hint--done {
    opacity: 0;
}

/* --- Stage progress ------------------------------------------------------ */
.stage-row {
    margin-bottom: 6px;
}

.stage-bar {
    height: 8px;
    margin-bottom: 12px;
    background-color: rgba(20, 12, 48, 0.9);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(110, 230, 224, 0.35);
    overflow: hidden;
}

.stage-bar-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(245, 197, 66);
    transition-property: width;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-cubic;
}

/* --- Toast (stage-up / new gem) ----------------------------------------- */
.toast {
    -unity-font-definition: url("project:///Assets/_Project/Art/ui-kit/fonts/Silkscreen-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    margin-top: 6px;
    padding: 8px 18px;
    color: rgb(245, 197, 66);
    background-color: rgba(12, 8, 32, 0.8);
    border-radius: 4px;
    transition-property: opacity, scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-back;
    opacity: 1;
    scale: 1 1;
}

.toast--hidden {
    opacity: 0;
    scale: 0.8 0.8;
}
