<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <!-- Full-screen transparent root; the HUD sits in the top-left corner. -->
    <ui:VisualElement name="hud-root" class="hud-root" picking-mode="Ignore">
        <!-- USS is linked on the root so the layout carries its own styling. -->
        <Style src="GameHUD.uss" />

        <!-- Crystal Cavern HUD window: panel_window 9-slice. -->
        <ui:VisualElement name="score-panel" class="panel">

            <ui:VisualElement class="heading-row">
                <ui:VisualElement name="heading-icon" class="heading-icon" />
                <!-- .panel-header = the class selector. -->
                <ui:Label name="hud-title" text="CRYSTALS" class="panel-header" />
            </ui:VisualElement>

            <!-- Each stat is a label on the left, a numeral hard right. -->
            <ui:VisualElement class="stat-row">
                <ui:Label text="SCORE" class="field-label" />
                <!-- #score-label = the ID selector; UIController queries by name. -->
                <ui:Label name="score-label" text="0" class="numeral numeral--gold score-numeral" />
            </ui:VisualElement>

            <ui:VisualElement class="stat-row">
                <ui:Label text="BEST" class="field-label" />
                <ui:Label name="high-score-label" text="0" class="numeral" />
            </ui:VisualElement>

            <!-- Button = the type selector; clicked is wired in UIController. -->
            <ui:Button name="restart-button" text="RESTART" class="restart-button" />
            <!-- Audio toggles. Music is OFF by default (see AudioDirector); the
                 labels are refreshed from the shared mute state at runtime. -->
            <ui:Button name="music-button" text="MUSIC: OFF" class="restart-button mute-button" />
            <ui:Button name="sfx-button" text="SFX: ON" class="restart-button mute-button" />
        </ui:VisualElement>

        <!-- Names the one verb in the game. Retires itself after the first score,
             so it teaches once and never nags. -->
        <ui:VisualElement name="place-hint-row" class="place-hint-row" picking-mode="Ignore">
            <ui:Label name="place-hint" text="SWAP TWO GEMS TO LINE UP 3" class="place-hint" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
