<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <!-- Full-screen transparent root; the HUD sits in the top-left corner. -->
    <ui:VisualElement name="hud-root" class="hud-root" picking-mode="Ignore">
        <!-- USS is linked on the root so the layout carries its own styling. -->
        <Style src="GameHUD.uss" />

        <!-- Crystal Cavern HUD window: panel_window 9-slice, 224px wide. -->
        <ui:VisualElement name="score-panel" class="panel">

            <ui:VisualElement class="heading-row">
                <ui:VisualElement name="heading-icon" class="heading-icon" />
                <!-- .panel-header = the class selector. -->
                <ui:Label name="hud-title" text="CRYSTALS" class="panel-header" />
            </ui:VisualElement>

            <!-- Each stat is a label on the left, a numeral hard right. -->
            <ui:VisualElement class="stat-row">
                <ui:Label text="SCORE" class="field-label" />
                <!-- #score-label = the ID selector; UIController queries by name. -->
                <ui:Label name="score-label" text="0" class="numeral numeral--gold" />
            </ui:VisualElement>

            <ui:VisualElement class="stat-row">
                <ui:Label text="BEST" class="field-label" />
                <ui:Label name="high-score-label" text="0" class="numeral" />
            </ui:VisualElement>

            <!-- The corruption clock. Every move winds it up, every merge winds it
                 back by the tier made; a full meter erupts a red crystal. The bar
                 matters more than the numerals — the fill ramps cyan to red so the
                 threat is legible without reading a fraction. -->
            <ui:VisualElement class="stat-row">
                <ui:Label text="CORRUPTION" class="field-label" />
                <ui:Label name="corruption-label" text="0/20" class="numeral numeral--warn" />
            </ui:VisualElement>
            <ui:VisualElement name="corruption-track" class="meter-track">
                <ui:VisualElement name="corruption-fill" class="meter-fill" />
            </ui:VisualElement>

            <!-- Pickaxe: banked charges, and the button that arms one. -->
            <ui:VisualElement class="stat-row">
                <ui:Label text="PICKAXE" class="field-label" />
                <ui:Label name="pickaxe-label" text="0" class="numeral numeral--gold" />
            </ui:VisualElement>

            <ui:Button name="pickaxe-button" text="SHATTER" class="restart-button pickaxe-button" />

            <!-- Shown only while the board is jammed and a charge is in hand. -->
            <ui:Label name="rescue-hint" text="STUCK! TAP A GEM TO SHATTER" class="rescue-hint" />

            <!-- Button = the type selector; clicked is wired in UIController. -->
            <ui:Button name="restart-button" text="RESTART" class="restart-button" />
            <ui:Button name="mute-button" text="SOUND: ON" class="restart-button mute-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
